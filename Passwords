names = ["Ali", "Mustafa"]
years = ["1990"]
football = ["Messi"]
cars = ["Nissan"]
cats = ["Siri"]
sons = ["Ahmed"]

special_chars = ["@", "#", "!", "$", "_"]

passwords = set()

start_time = time.time()

while len(passwords) < 100000:
    pattern = random.randint(1, 6)

    name = random.choice(names)
    year = random.choice(years)
    player = random.choice(football)
    car = random.choice(cars)
    cat = random.choice(cats)
    son = random.choice(sons)
    num = str(random.randint(0, 9999))
    special = random.choice(special_chars)

    if pattern == 1:
        pwd = name + year
    elif pattern == 2:
        pwd = player + special + year
    elif pattern == 3:
        pwd = car + "_" + son
    elif pattern == 4:
        pwd = cat + num + "!"
    elif pattern == 5:
        pwd = name.lower() + special + num
    elif pattern == 6:
        pwd = name.upper() + num + special

    passwords.add(pwd)

with open("passwords.txt", "w") as f:
    for p in passwords:
        f.write(p + "\n")

end_time = time.time()

print("Successfully generated 100000 passwords")
print("Saved to: passwords.txt")
print(f"Time elapsed: {round(end_time - start_time, 2)} seconds")
